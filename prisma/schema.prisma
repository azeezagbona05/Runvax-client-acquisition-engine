generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                   @id @default(cuid())
  name                     String?
  email                    String?                  @unique
  emailVerified            DateTime?
  image                    String?
  password                 String?
  plan                     String                   @default("free")
  paystackCustomerCode     String?
  paystackSubscriptionCode String?
  planExpiresAt            DateTime?
  expiryReminderSentAt     DateTime? // set when Argus emails a renewal reminder; cleared whenever planExpiresAt is (re)extended
  searchLimitOverride      Int? // null = use plan default; set to override daily search limit
  blockedLocations         String?                  @db.Text // JSON string[] of blocked location keywords
  blockedCountries         String?                  @db.Text // JSON string[] of blocked country codes e.g. ["NG","GH"]
  registrationIp           String? // IP address captured at signup
  lastSeenIp               String? // IP address from most recent sign-in
  lastActiveAt             DateTime? // last time the user actually used the app (touched on sign-in + throttled on every session refresh)
  isSuspended              Boolean                  @default(false) // blocks sign-in and API usage when true
  termsAcceptedAt          DateTime? // set at registration when user checks the Terms/Privacy consent box
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  accounts                 Account[]
  integrationConnections   IntegrationConnection[]
  customAgents             CustomAgent[]
  knowledgeSources         KnowledgeSource[]
  careerProfile            CareerProfile?
  careerDocuments          CareerDocument[]
  careerPreference         CareerPreference?
  careerEvents             CareerAgentEvent[]
  jobListings              JobListing[]
  jobMatches               JobMatch[]
  jobApplications          JobApplication[]
  careerInterviews         CareerInterview[]
  careerResponses          CareerResponse[]
  applicationSubmissions   ApplicationSubmission[]
  sessions                 Session[]
  prospects                Prospect[]
  settings                 UserSettings?
  dailyLogs                DailyLog[]
  usageRecords             UsageRecord[]
  searchHistory            SearchHistory[]
  payments                 Payment[]
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  demoSites                DemoSite[]
  webAuthnCredentials      WebAuthnCredential[]
  outreachSignals          OutreachSignal[]
  agentActivities          AgentActivity[]
  outreachDrafts           OutreachDraft[]
  atlasBriefs              AtlasBrief[]
  billingBriefs            BillingBrief[]
  agentTasks               AgentTask[]
  campaigns                Campaign[]
  lifecycleEmails          LifecycleEmail[]
  outreachCampaigns        OutreachCampaign[]
  prospectMemories         ProspectMemory[]

  acquisitionProspects       AcquisitionProspect[]
  acquisitionSources         AcquisitionSource[]
  acquisitionDecisionMakers  AcquisitionDecisionMaker[]
  acquisitionFindings        AcquisitionFinding[]
  acquisitionRecommendations AcquisitionRecommendation[]
  acquisitionDrafts          AcquisitionDraft[]
  acquisitionApprovals       AcquisitionApproval[]
  acquisitionSuppressions    AcquisitionSuppression[]
  acquisitionTasks           AcquisitionTask[]
  acquisitionAgentRuns       AcquisitionAgentRun[]
  acquisitionEvents          AcquisitionPipelineEvent[]
  acquisitionCandidates      AcquisitionCandidate[]
  acquisitionImportBatches   AcquisitionImportBatch[]
  acquisitionIdentities      AcquisitionIdentity[]
  acquisitionSignals         AcquisitionSignal[]
  acquisitionScores          AcquisitionScore[]
  acquisitionPageCache       AcquisitionPageCache[]
  acquisitionOutcomes        AcquisitionOutcome[]
}

model WebAuthnCredential {
  id           String   @id @default(cuid())
  userId       String
  credentialId String   @unique
  publicKey    Bytes
  counter      Int      @default(0)
  transports   String?
  deviceName   String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Prospect {
  id                String               @id @default(cuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId        String
  businessName      String
  businessData      Json
  stage             String               @default("found")
  notes             String?              @db.Text
  score             Int?
  estimatedPriceMin Int?
  estimatedPriceMax Int?
  savedAt           DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  outreachSentAt    DateTime?
  reminderDate      String?
  reminderNote      String?
  followUpSequence  Json?
  source            String? // 'manual' | 'auto-prospect' | 'campaign'
  campaignId        String?
  conversations     Conversation[]
  outreachDrafts    OutreachDraft[]
  acquisition       AcquisitionProspect?

  @@unique([userId, businessId])
  @@index([campaignId])
}

model Conversation {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  type       String
  channel    String
  content    String   @db.Text
  replyType  String?
  framework  String?
  createdAt  DateTime @default(now())
}

// Cross-user outreach tracker ("lead saturation").
//
// One row per (business, user) pair — the unique constraint is what makes the
// aggregate honest: contacting the same business five times still counts as one
// user. Reads are always aggregates (COUNT / MAX), never identities: no endpoint
// exposes which users are in the count.
//
// businessId is the globally stable provider id (Google Place ID, or osm_<id>).
// Locally-generated `manual_*` ids are never written here — they are unique per
// user, so they would only ever report a count of 1 and dilute nothing but trust.
model OutreachSignal {
  id          String   @id @default(cuid())
  businessId  String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel     String // whatsapp | email | dm | call — channel of the most recent send
  sendCount   Int      @default(1)
  firstSentAt DateTime @default(now())
  lastSentAt  DateTime @default(now())

  @@unique([businessId, userId])
  @@index([businessId, lastSentAt])
}

// Feeds the Command Centre activity log — a short, human-readable trace of
// what each named agent (research/outreach/seo/support) actually did, so the
// feed only ever shows real, verifiable events rather than decorative copy.
model AgentActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentKey  String // research | outreach | seo | support | atlas
  action    String // e.g. opportunity_flagged, message_sent, content_generated, question_answered
  title     String // human-readable one-liner shown in the feed
  detail    String?  @db.Text
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Rex (outreach agent) working 24/7 without ever sending on its own — a
// message is composed and parked here for a human to review and send. Never
// written to Conversation/OutreachSignal until a person actually sends it.
model OutreachDraft {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prospectId        String
  prospect          Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  channel           String // whatsapp | email
  whatsapp          String?  @db.Text
  emailSubject      String?
  emailBody         String?  @db.Text
  framework         String?
  opportunityTitle  String?
  opportunityReason String?  @db.Text
  priorContext      Json? // recalled prospect facts used while composing, for display before send
  status            String   @default("pending") // pending | sent | dismissed
  createdAt         DateTime @default(now())

  @@index([userId, status])
}

// ATLAS — the orchestrator. One cached brief per user per day: a rule-based
// (no LLM call) synthesis of that user's own pipeline + agent activity, plus
// recommended actions the user can delegate with one click. Regenerating the
// same day's brief is idempotent (unique on [userId, date]).
model AtlasBrief {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            String // YYYY-MM-DD, matches DailyLog/UsageRecord convention
  summary         String   @db.Text
  recommendations Json // [{ type, label, detail, count, done }]
  createdAt       DateTime @default(now())

  @@unique([userId, date])
}

// MILO — the billing/upsell agent. Same cache-once-per-day pattern as
// AtlasBrief, but read-only: there is no delegated server-side action here
// (the only real "action" is paying, which can't be automated), so
// recommendations render as plain links rather than one-click delegations.
model BillingBrief {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            String
  summary         String   @db.Text
  recommendations Json // [{ type, label, detail, count, href }]
  createdAt       DateTime @default(now())

  @@unique([userId, date])
}

// ARGUS — the admin-ops agent. Platform-wide daily brief (no userId: there is
// no admin-user model, admin-ness is the ADMIN_EMAILS env allowlist), same
// cache-once-per-day pattern as AtlasBrief. Recommendations are surfaced in
// the admin dashboard and can be delegated with one click.
model AdminBrief {
  id              String   @id @default(cuid())
  date            String   @unique // YYYY-MM-DD
  summary         String   @db.Text
  recommendations Json // [{ type, label, detail, count, done }]
  createdAt       DateTime @default(now())
}

// Audit trail for actions an admin delegates to Argus (e.g. batch-sending
// renewal reminders), so there's a record of who triggered what and when.
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorEmail String // admin who triggered the action
  action     String // e.g. sent_expiry_reminders
  title      String
  detail     String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Point-in-time capture of a business's mutable Places fields.
//
// CachedBusiness only ever holds current values, so there is nothing to compare
// against — these rows are what make change detection possible. Written at most
// once per business per day (the unique constraint enforces it) from the search
// path, which already refreshes this exact data.
//
// Subject to the same 90-day retention as CachedBusiness: this is cached Places
// content and the existing ToS cleanup policy applies to it too.
model BusinessSnapshot {
  id          String   @id @default(cuid())
  placeId     String
  date        String // YYYY-MM-DD — matches the DailyLog / UsageRecord convention
  rating      Float?
  reviewCount Int?
  hasWebsite  Boolean  @default(false)
  capturedAt  DateTime @default(now())

  @@unique([placeId, date])
  @@index([placeId, date])
  @@index([capturedAt])
}

// A detected buying signal — the local-business equivalent of a "changed jobs"
// alert. One active trigger per (business, type): re-detecting refreshes the
// detail and timestamp rather than piling up duplicates.
model LeadTrigger {
  id           String   @id @default(cuid())
  placeId      String
  type         String // new_business | review_surge | rating_drop | website_lost | website_gained
  businessName String
  category     String?
  city         String?
  country      String   @default("NG")
  detail       String   @db.Text // human-readable, e.g. "reviews jumped 12 → 47 in 14 days"
  strength     String // hot | warm | negative
  detectedAt   DateTime @default(now())

  @@unique([placeId, type])
  @@index([city, detectedAt])
  @@index([category, detectedAt])
  @@index([detectedAt])
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Prospecting goals
  dailyGoal    Int @default(10)
  avgDealValue Int @default(300000)
  closeRatePct Int @default(10)

  // Sender identity — used in proposals, email signatures, outreach
  senderName   String?
  businessName String?
  whatsapp     String?
  replyEmail   String?
  city         String?
  tagline      String?
  jobTitle     String?
  website      String?

  // Custom SMTP — overrides platform SMTP when filled in
  smtpHost String?
  smtpPort Int?
  smtpUser String?
  smtpPass String? @db.Text
  smtpFrom String?

  // Bank / payment details — printed in proposals
  bankName     String?
  bankAccount  String?
  bankAcctName String?
  paymentLink  String?

  // Rate card — JSON blob storing packages, maintenance plans, add-ons, and payment terms
  rateCard Json?

  // Portfolio — array of { url, description } website examples
  portfolio Json?

  // Onboarding
  onboardingDone Boolean @default(false)

  // Autonomous prospecting — Ava (research agent) scans on this user's behalf
  // daily via cron when enabled. Persisted server-side (not just localStorage)
  // so the cron can see it.
  autoProspectEnabled       Boolean @default(false)
  autoProspectIndustry      String?
  autoProspectLocation      String?
  autoProspectMinRating     Float   @default(0)
  autoProspectNoWebsiteOnly Boolean @default(true)

  // Rex (outreach agent) drafts messages for un-contacted prospects daily via
  // cron when enabled. Off by default — never touches a user's prospects or
  // AI-call quota until they explicitly opt in, same consent model as Ava above.
  autoDraftEnabled Boolean @default(false)

  // WhatsApp Business API
  waPhoneNumberId  String?
  waAccessToken    String? @db.Text
  waTemplateName   String?
  wabaId           String?
  waDisplayPhone   String?
  waTemplateStatus String?

  updatedAt DateTime @updatedAt
}

model DailyLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   String
  count  Int    @default(0)

  @@unique([userId, date])
}

model UsageRecord {
  id                   String  @id @default(cuid())
  userId               String
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                 String
  aiCalls              Int     @default(0)
  searchCount          Int     @default(0)
  // Token tracking for cost calculation
  openaiInputTokens    Int     @default(0)
  openaiOutputTokens   Int     @default(0)
  geminiInputTokens    Int     @default(0)
  geminiOutputTokens   Int     @default(0)
  // Google Places API requests (each search can make up to 3 paginated requests)
  googlePlacesReqs     Int     @default(0)
  // Guards against re-sending the "limit reached — upgrade" email on every
  // subsequent request once a user has already been notified for the day
  searchLimitEmailSent Boolean @default(false)
  aiLimitEmailSent     Boolean @default(false)

  @@unique([userId, date])
}

model Payment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference String   @unique
  plan      String
  amount    Int
  status    String   @default("success")
  paidAt    DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model SearchHistory {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  industry       String
  location       String
  totalCount     Int      @default(0)
  noWebsiteCount Int      @default(0)
  searchedAt     DateTime @default(now()) @updatedAt

  @@unique([userId, industry, location])
  @@index([userId])
}

model PlanConfig {
  id               String   @id @default(cuid())
  planId           String   @unique
  name             String   @default("")
  price            String?
  priceNote        String   @default("per month")
  searchesPerDay   Int
  resultsPerSearch Int
  aiCallsPerDay    Int
  maxProspects     Int
  // Comma-separated feature ids the plan unlocks. NULL = fall back to code defaults.
  features         String?  @db.Text
  // JSON string[] of allowed location keywords. NULL = all locations allowed.
  allowedLocations String?  @db.Text
  // JSON string[] of allowed country codes e.g. ["NG","KE"]. NULL = all countries allowed.
  allowedCountries String?  @db.Text
  updatedAt        DateTime @updatedAt
}

model DemoSite {
  id           String   @id @default(cuid())
  slug         String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId   String
  businessName String
  data         Json
  views        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, businessId])
  @@index([userId])
}

// Search result cache — avoids repeat Google Places API calls within 7 days
model SearchCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  query     String   @db.Text
  country   String   @default("NG")
  radius    Int      @default(5)
  results   Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Proprietary African SMB intelligence database — the moat
// Every business ever returned from Google Places is cached here.
// Outcome data (contacted, converted, deal values) accumulates across all users anonymously.
model CachedBusiness {
  id                 String    @id @default(cuid())
  placeId            String    @unique
  name               String
  category           String
  address            String?
  city               String?
  country            String    @default("NG")
  phone              String?
  website            String?   @db.Text
  hasWebsite         Boolean   @default(false)
  rating             Float?
  reviewCount        Int?
  // Rich detail fields — populated on first drawer open, cached for 7 days
  description        String?   @db.Text
  openingHours       Json?
  categoryTypes      Json?
  reviews            Json?
  competitors        Json?
  detailsRefreshedAt DateTime?

  // Discovered emails — crawled from business website, cached for 30 days
  discoveredEmails Json? // [{email, source, page}]
  emailsCrawledAt  DateTime?

  // PageSpeed Insights — mobile + desktop performance scores 0-100, checked on demand
  psiScore        Int?
  psiDesktopScore Int?
  psiDetails      Json?
  psiScreenshot   String?   @db.MediumText
  psiCheckedAt    DateTime?

  // Aggregate outcome data (anonymized, accumulated across all users)
  timesSearched  Int      @default(1)
  timesContacted Int      @default(0)
  timesConverted Int      @default(0)
  totalDealValue Int      @default(0)
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @updatedAt

  @@index([country, city])
  @@index([category])
  @@index([hasWebsite])
}

// The hand-off queue between agents. An agent never calls another agent: it
// finishes, then enqueues the next task (parentTaskId keeps the chain), and a
// runner claims pending tasks. Gives retries, a per-prospect trail, and one
// place to see where work is stuck.
model AgentTask {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String // detect_opportunity | draft_outreach
  status       String    @default("pending") // pending | running | completed | failed | skipped
  prospectId   String?
  parentTaskId String?
  input        Json?
  output       Json?
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  scheduledAt  DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  error        String?   @db.Text
  createdAt    DateTime  @default(now())

  @@index([status, scheduledAt])
  @@index([userId, createdAt])
  @@index([prospectId])
}

// A standing instruction ("dental clinics in Lagos, 20 a day") that the
// campaign runner executes daily: import prospects up to dailyCap, then hand
// each to the agent task queue. Pausing stops imports; it never deletes data.
model Campaign {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  industry      String
  location      String
  noWebsiteOnly Boolean   @default(true)
  minRating     Float     @default(0)
  dailyCap      Int       @default(20)
  status        String    @default("active") // active | paused
  lastRunAt     DateTime?
  totalImported Int       @default(0)
  createdAt     DateTime  @default(now())

  @@index([userId, status])
}

// What the agents have learned about one prospect, kept as short facts with a
// source and a confidence so any agent (or the user) can see where a claim
// came from. Append-only; identical facts are not stored twice.
model ProspectMemory {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prospectId String
  kind       String // opportunity | reply | note
  content    String   @db.Text
  source     String // e.g. ava_detection | reply_analysis
  confidence String   @default("medium") // low | medium | high
  createdAt  DateTime @default(now())

  @@index([prospectId, createdAt])
  @@index([userId])
}

// ─── Industry Acquisition Engine ─────────────────────────────────────────────
//
// Admin-only, behind INDUSTRY_ACQUISITION_ENABLED. Every table here is new and
// additive: nothing in the existing RUNVAX workflow reads or writes them, and
// they add no columns to existing tables. Industry rules live in code
// (src/lib/acquisition/config), not in the database.

// The acquisition view of one existing Prospect row (1:1). The CRM `stage` on
// Prospect is left alone; `state` is the acquisition lifecycle, changed only
// through recorded AcquisitionPipelineEvent transitions.
model AcquisitionProspect {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  prospectId      String    @unique
  prospect        Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  industryKey     String
  state           String    @default("discovered")
  fitScore        Int? // model/rule estimate, never an observed result
  scoreIsEstimate Boolean   @default(true)
  discoveredAt    DateTime  @default(now())
  lastVerifiedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  // Phase 2
  candidateId     String?
  importBatchId   String?
  area            String?
  orgDomain       String? // registrable domain, links branches of one organisation
  crmConflict     String? // why this clinic is already in the CRM / already contacted
  lastScoredAt    DateTime?

  sources         AcquisitionSource[]
  decisionMakers  AcquisitionDecisionMaker[]
  findings        AcquisitionFinding[]
  recommendations AcquisitionRecommendation[]
  drafts          AcquisitionDraft[]
  tasks           AcquisitionTask[]
  events          AcquisitionPipelineEvent[]
  identities      AcquisitionIdentity[]
  signals         AcquisitionSignal[]
  scores          AcquisitionScore[]
  outcomes        AcquisitionOutcome[]

  @@index([userId, industryKey, state])
}

// Where a fact came from. Content itself is not stored — only a hash, so a
// re-fetch of identical content is recognised without keeping the page.
model AcquisitionSource {
  id            String              @id @default(cuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  acqProspectId String
  acqProspect   AcquisitionProspect @relation(fields: [acqProspectId], references: [id], onDelete: Cascade)
  kind          String // places | website | csv | manual
  url           String?             @db.Text
  contentHash   String
  fetchedAt     DateTime            @default(now())
  // Phase 2
  method        String? // fetcher | csv_import | manual_entry
  httpStatus    Int?
  robotsAllowed Boolean?

  @@unique([acqProspectId, kind, contentHash])
  @@index([userId])
}

model AcquisitionDecisionMaker {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  acqProspectId  String
  acqProspect    AcquisitionProspect @relation(fields: [acqProspectId], references: [id], onDelete: Cascade)
  name           String?
  role           String?
  email          String?
  channel        String              @default("email")
  verification   String              @default("unverified") // unverified | verified | conflicting | bounced
  sourceId       String?
  observedAt     DateTime            @default(now())
  confidence     String              @default("low") // low | medium | high
  createdAt      DateTime            @default(now())
  // Phase 2. Automatic research only ever creates role_inbox / business_phone
  // rows (no person). manual_named rows come from an admin with a source.
  kind           String              @default("role_inbox") // role_inbox | business_phone | manual_named
  contactKey     String? // sha256 of the normalised email/phone/name, for idempotency
  phone          String?
  sourceUrl      String?             @db.Text
  sourceNote     String?             @db.Text
  evidenceQuote  String?             @db.Text
  mxValid        Boolean?
  lastVerifiedAt DateTime?
  lawfulBasis    String              @default("legitimate_interest_b2b")
  retainUntil    DateTime?
  flags          Json?

  @@unique([acqProspectId, email])
  @@unique([acqProspectId, contactKey])
  @@index([userId])
}

model AcquisitionFinding {
  id                 String              @id @default(cuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  acqProspectId      String
  acqProspect        AcquisitionProspect @relation(fields: [acqProspectId], references: [id], onDelete: Cascade)
  category           String
  polarity           String // strength | weakness
  basis              String // observed | inferred
  finding            String              @db.Text
  evidence           String              @db.Text
  sourceId           String?
  observedAt         DateTime            @default(now())
  impactHypothesis   String?             @db.Text
  confidence         String              @default("low")
  validationQuestion String?             @db.Text
  solutionCategory   String?
  createdAt          DateTime            @default(now())
  // Phase 2
  findingKey         String? // category + rule; makes re-audits update rather than duplicate
  signalIds          Json?

  @@unique([acqProspectId, findingKey])
  @@index([acqProspectId, category])
  @@index([userId])
}

model AcquisitionRecommendation {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  acqProspectId     String
  acqProspect       AcquisitionProspect @relation(fields: [acqProspectId], references: [id], onDelete: Cascade)
  primaryOfferId    String
  secondaryOfferId  String?
  rationale         String              @db.Text
  findingIds        Json // string[]
  targetRole        String?
  angle             String?             @db.Text
  cta               String?             @db.Text
  confidence        String              @default("low")
  missingInfo       Json? // string[]
  createdAt         DateTime            @default(now())
  // Phase 2
  scoreId           String?
  offerStatusAtTime String?

  @@unique([acqProspectId, scoreId])
  @@index([acqProspectId])
  @@index([userId])
}

// Kept apart from OutreachDraft on purpose: the existing draft queue has
// WhatsApp/email send buttons and an advisory gate. Acquisition drafts can
// only leave through the blocking gate in src/lib/acquisition/gate.ts.
model AcquisitionDraft {
  id                    String              @id @default(cuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  acqProspectId         String
  acqProspect           AcquisitionProspect @relation(fields: [acqProspectId], references: [id], onDelete: Cascade)
  channel               String              @default("email")
  recipientDmId         String?
  subject               String?
  body                  String              @db.Text
  evidenceFindingIds    Json // string[]
  offerId               String
  status                String              @default("draft") // pending_approval | approved | ready | rejected | stale | superseded | blocked | invalidated | sent (legacy: draft | regenerate_requested)
  riskFlags             Json?
  gateResult            Json?
  version               Int                 @default(1)
  idempotencyKey        String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  // Sales-workflow phase: what the draft was generated from, so it can be
  // invalidated when the evidence or the offer configuration changes.
  evidenceSignalIds     Json? // string[] — the signals the text relies on
  evidenceHash          String? // hash of those signals' content at generation
  offerHash             String? // hash of the offer configuration used
  offerConfigVersion    Int?
  industryConfigVersion Int?
  readiness             Json? // last readiness check: { ready, blockers[] }
  statusReason          String?             @db.Text

  approvals AcquisitionApproval[]

  @@unique([userId, idempotencyKey])
  @@index([userId, status])
  @@index([acqProspectId])
}

// Append-only record of every human decision on a draft.
model AcquisitionApproval {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  draftId        String
  draft          AcquisitionDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  action         String // approve | edit | reject | regenerate | mark_ready | invalidate
  actorEmail     String
  note           String?          @db.Text
  bodyHashBefore String?
  bodyHashAfter  String?
  // An approval is bound to the exact text AND the evidence and offer
  // versions it was given for; any change makes it stale.
  evidenceHash   String?
  offerHash      String?
  createdAt      DateTime         @default(now())

  @@index([draftId, createdAt])
  @@index([userId])
}

// Contacts that must never be messaged by the acquisition engine.
model AcquisitionSuppression {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // email | phone | domain | crawl_domain
  // Phase 2: matching is by valueHash (sha256 of the normalised value). The
  // plain value is kept only for domain / crawl_domain, never for an email or
  // phone, so an erasure tombstone does not itself retain the erased value.
  value     String?
  valueHash String
  reason    String // opt_out | objection | erasure | complaint | bounce | manual | retention_expiry
  source    String
  expiresAt DateTime? // only retention_expiry markers expire
  createdAt DateTime  @default(now())

  @@unique([userId, kind, valueHash])
}

// The acquisition engine's own queue. Separate from AgentTask so the existing
// drainer and its budget never see acquisition work, and vice versa.
model AcquisitionTask {
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String
  status         String               @default("pending") // pending | running | completed | skipped | failed | dead | cancelled
  acqProspectId  String?
  acqProspect    AcquisitionProspect? @relation(fields: [acqProspectId], references: [id], onDelete: Cascade)
  parentTaskId   String?
  idempotencyKey String
  input          Json?
  output         Json?
  attempts       Int                  @default(0)
  maxAttempts    Int                  @default(3)
  scheduledAt    DateTime             @default(now())
  lockedUntil    DateTime?
  completedAt    DateTime?
  error          String?              @db.Text
  createdAt      DateTime             @default(now())

  runs AcquisitionAgentRun[]

  @@unique([userId, idempotencyKey])
  @@index([status, scheduledAt])
  @@index([acqProspectId])
}

// One row per attempt — what ran, on which model, at what (estimated) cost.
model AcquisitionAgentRun {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId        String
  task          AcquisitionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent         String
  attempt       Int
  status        String // running | succeeded | failed
  provider      String?
  model         String?
  inputTokens   Int?
  outputTokens  Int?
  costUsdMicros Int? // estimate from configured prices, not an invoice
  durationMs    Int?
  inputHash     String?
  evidenceRefs  Json?
  error         String?         @db.Text
  startedAt     DateTime        @default(now())
  finishedAt    DateTime?

  @@index([taskId])
  @@index([userId, startedAt])
}

model AcquisitionPipelineEvent {
  id            String              @id @default(cuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  acqProspectId String
  acqProspect   AcquisitionProspect @relation(fields: [acqProspectId], references: [id], onDelete: Cascade)
  fromState     String
  toState       String
  reason        String              @db.Text
  actor         String // agent key or admin email
  createdAt     DateTime            @default(now())

  @@index([acqProspectId, createdAt])
  @@index([userId])
}

// ─── Industry Acquisition Engine — Phase 2 (prospect intelligence) ───────────

// A business seen in Google Places. Only place_id is kept (Google Maps
// Platform Service Specific Terms §A.3); every other Places field is used in
// memory and dropped. Places discovery is disabled in Phase 2.
model AcquisitionCandidate {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  industryKey   String
  placeId       String
  area          String? // the area WE searched, never derived from Places coordinates
  queryIndex    Int?
  status        String   @default("pending_research") // pending_research | promoted | no_independent_source | excluded
  acqProspectId String?
  discoveredAt  DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, placeId])
  @@index([userId, status])
}

// One CSV upload or manual entry. Parsed rows are held only between preview
// and commit (cleared on commit or expiry).
model AcquisitionImportBatch {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  industryKey    String
  kind           String // csv | manual
  label          String?
  fileHash       String
  status         String    @default("previewed") // previewed | committed | expired
  rowCount       Int       @default(0)
  acceptedCount  Int       @default(0)
  duplicateCount Int       @default(0)
  rejectedCount  Int       @default(0)
  rows           Json? // normalised accepted rows, cleared on commit
  results        Json? // per-row outcome + reasons (no raw values)
  attestedBy     String?
  attestedAt     DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  @@unique([userId, fileHash])
  @@index([userId, createdAt])
}

// Duplicate-detection keys. Strong kinds (place_id, domain, phone) merge;
// name_area is weak and only flags a possible duplicate.
model AcquisitionIdentity {
  id            String              @id @default(cuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  acqProspectId String
  acqProspect   AcquisitionProspect @relation(fields: [acqProspectId], references: [id], onDelete: Cascade)
  kind          String // place_id | domain | phone | name_area
  value         String
  createdAt     DateTime            @default(now())

  @@unique([userId, kind, value])
  @@index([acqProspectId])
}

// One observed / inferred / unknown fact from an independent source.
model AcquisitionSignal {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  acqProspectId  String
  acqProspect    AcquisitionProspect @relation(fields: [acqProspectId], references: [id], onDelete: Cascade)
  code           String
  value          Json?
  basis          String // observed | inferred | unknown
  method         String // html_rule | csv | manual | industry_config | psi_api
  confidence     String // high | medium | low
  sourceId       String?
  sourceUrl      String?             @db.Text
  evidenceQuote  String?             @db.Text
  contentHash    String
  observedAt     DateTime            @default(now())
  lastVerifiedAt DateTime            @default(now())
  supersededAt   DateTime?
  createdAt      DateTime            @default(now())

  @@unique([acqProspectId, code, contentHash])
  @@index([acqProspectId, code])
  @@index([userId])
}

// Append-only, versioned score history. inputHash makes re-scoring identical
// inputs a no-op.
model AcquisitionScore {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  acqProspectId  String
  acqProspect    AcquisitionProspect @relation(fields: [acqProspectId], references: [id], onDelete: Cascade)
  industryKey    String
  configVersion  Int
  scoreVersion   String
  total          Int
  band           String
  coverage       Float
  contactability String
  eligible       Boolean
  eligibility    Json
  breakdown      Json
  inputHash      String
  computedAt     DateTime            @default(now())

  @@unique([acqProspectId, inputHash])
  @@index([acqProspectId, computedAt])
  @@index([userId])
}

// Short-lived page store so contact research and the audit don't fetch twice.
// Purged after every queue run and by expiresAt (24h).
model AcquisitionPageCache {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain     String
  url        String   @db.Text
  urlHash    String
  finalUrl   String?  @db.Text
  status     String // ok | robots_disallowed | blocked | http_error | timeout | too_large | not_html | error
  httpStatus Int?
  html       String?  @db.MediumText
  fetchedAt  DateTime @default(now())
  expiresAt  DateTime

  @@unique([userId, urlHash])
  @@index([expiresAt])
  @@index([userId, domain])
}

// Platform-wide daily usage counters (Africa/Lagos calendar day). Every
// external call reserves a unit here first, atomically — see budget.ts.
model AcquisitionProviderUsage {
  id                  String    @id @default(cuid())
  provider            String // google_places | web_page | pagespeed | dns | acq_tasks
  day                 String // YYYY-MM-DD in Africa/Lagos
  calls               Int       @default(0)
  consecutiveFailures Int       @default(0)
  lastFailureAt       DateTime?
  pausedUntil         DateTime?
  updatedAt           DateTime  @updatedAt

  @@unique([provider, day])
}

// Manually recorded sales outcomes (append-only), the basis of funnel metrics.
// Nothing is sent or detected automatically: a reviewer records what happened.
model AcquisitionOutcome {
  id            String              @id @default(cuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  acqProspectId String
  acqProspect   AcquisitionProspect @relation(fields: [acqProspectId], references: [id], onDelete: Cascade)
  draftId       String?
  type          String // sent | reply | opt_out | objection | meeting_booked | proposal_sent | won | lost
  sentiment     String? // reply: positive | neutral | negative
  amount        Int? // proposal_sent / won: whole currency units (e.g. naira, not kobo)
  currency      String? // ISO 4217, required with an amount
  reason        String?             @db.Text
  actorEmail    String
  occurredAt    DateTime
  createdAt     DateTime            @default(now())

  @@index([acqProspectId, occurredAt])
  @@index([userId, type])
}

// One row per lifecycle email a user has been sent (key = the step), plus 'optout' when they
// unsubscribe from promotional emails. The unique pair is what makes the onboarding sequence
// idempotent: a step can be claimed once, however often the cron runs.
model LifecycleEmail {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key    String
  sentAt DateTime @default(now())

  @@unique([userId, key])
  @@index([key])
}

// ─── Email outreach campaigns ────────────────────────────────────────────────
//
// A user uploads leads, writes one pitch, and presses Run: the pitch goes out from
// the user's own mailbox, a few at a time (dailyCap), and this table pair is the
// dashboard's source of truth (sent / opened / replied / needs follow-up).
// Not the same as `Campaign` above, which is a standing prospecting instruction.
model OutreachCampaign {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  subject           String
  body              String   @db.Text
  followUpSubject   String?
  followUpBody      String?  @db.Text
  followUpAfterDays Int      @default(3)
  maxFollowUps      Int      @default(1)
  dailyCap          Int      @default(30)
  // The full automation plan from the builder (sequence, conditions, reply rules). The engine runs the subset it supports.
  automation        Json?
  status            String   @default("draft") // draft | running | paused | completed
  startedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  leads             OutreachLead[]
  replies           CampaignReply[]
  logs              CampaignLog[]

  @@index([userId, status])
}

model OutreachLead {
  id            String           @id @default(cuid())
  campaignId    String
  campaign      OutreachCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId        String
  email         String
  name          String?
  business      String?
  website       String?
  // queued | sending | sent | failed | skipped | unsubscribed
  status        String           @default("queued")
  // Random per-lead secret used by the open pixel and the unsubscribe link.
  token         String           @unique
  messageId     String?
  // Written for this one lead by the RUNVAX pitch engine; replaces the campaign's template for their first email.
  customSubject String?
  customBody    String?          @db.Text
  sentAt        DateTime?
  lastSentAt    DateTime?
  followUpsSent Int              @default(0)
  openedAt      DateTime?
  openCount     Int              @default(0)
  clickedAt     DateTime?
  clickCount    Int              @default(0)
  repliedAt     DateTime?
  // What the sender decided about a reply: interested | not_interested. Null = not looked at yet.
  outcome       String?
  // What the reply was, as read by the Reply Intelligence agent: interested | info_request | meeting_request | objection | not_interested | out_of_office | unsubscribe | other.
  replyClass    String?
  // Out-of-office: no follow-up before this time.
  pausedUntil   DateTime?
  // Set by the sender once a prospect goes past 'interested': demo_booked | proposal_sent | customer | lost.
  stage         String?
  demoAt        DateTime?
  closedAt      DateTime?
  dealValue     Int?
  ownerNotifiedAt DateTime?
  replies       CampaignReply[]
  whatsapp      LeadWhatsApp?
  unsubscribedAt DateTime?
  error         String?          @db.Text
  createdAt     DateTime         @default(now())

  @@unique([campaignId, email])
  @@index([campaignId, status])
  @@index([userId, email])
  @@index([userId, createdAt])
}

// The WhatsApp side of a campaign contact: their phone number and whether the approved template has been sent.
model LeadWhatsApp {
  id         String       @id @default(cuid())
  userId     String
  campaignId String
  leadId     String       @unique
  lead       OutreachLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  phone      String       @db.VarChar(32)
  sentAt     DateTime?
  messageId  String?
  error      String?      @db.VarChar(500)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([userId, sentAt])
  @@index([campaignId, sentAt])
  @@index([userId, phone])
}

// A reply from a prospect, matched to the campaign and contact it answers. Only messages from addresses that are
// contacts of a campaign are ever stored; nothing else in a mailbox is read into RUNVAX.
model CampaignReply {
  id           String           @id @default(cuid())
  userId       String
  campaignId   String
  campaign     OutreachCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId       String
  lead         OutreachLead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messageId    String?
  source       String           @default("manual") // manual | inbox
  fromEmail    String
  subject      String?
  text         String           @db.Text
  receivedAt   DateTime
  replyClass   String
  confidence   Float            @default(0.7)
  classifiedBy String           @default("rules") // rules | ai
  suggestion   String?          @db.Text
  suggestionBy String?
  respondedAt  DateTime?
  createdAt    DateTime         @default(now())

  @@unique([userId, messageId])
  @@index([userId, receivedAt])
  @@index([leadId])
}

// What each agent did on a campaign, in order: the one shared record the whole acquisition workforce writes to.
model CampaignLog {
  id         String            @id @default(cuid())
  userId     String
  campaignId String?
  campaign   OutreachCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId     String?
  agent      String // strategist | audience | content | outreach | followup | reply
  action     String
  detail     String?           @db.Text
  createdAt  DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([campaignId, createdAt])
}

// A user's saved campaign template ("My Templates"). Structure only: no contacts, replies or results.
model CampaignTemplate {
  id             String   @id @default(cuid())
  userId         String
  name           String
  industry       String
  description    String?  @db.VarChar(500)
  baseTemplateId String?
  data           Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, createdAt])
}

// A tool a user has connected to Client Acquisition (Apollo, Snov.io, Google Calendar, Airtable, webhooks).
// WhatsApp and email live in UserSettings already, so they are not stored here. `secret` is AES-GCM encrypted JSON.
model IntegrationConnection {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      String
  secret        String?   @db.Text
  meta          Json?
  // connected | error
  status        String    @default("connected")
  statusDetail  String?   @db.VarChar(500)
  lastCheckedAt DateTime?
  lastSyncAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, provider])
}

// Purchased or granted email-reveal credits (the wallet). Monthly plan allowances are counted from the ledger.
model EmailWallet {
  userId    String   @id
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Every email-reveal credit used or added. (userId, revealKey) is unique so one revealed email is never charged twice.
model EmailCreditLedger {
  id        String   @id @default(cuid())
  userId    String
  kind      String // reveal | topup | grant
  source    String // allowance | wallet
  credits   Int
  revealKey String?
  period    String? // YYYY-MM, for allowance use
  note      String?
  createdAt DateTime @default(now())

  @@unique([userId, revealKey])
  @@index([userId, kind, source, period])
}

// An AI agent the user built in Client Acquisition. `kind` picks the template (visibility = writes articles for a website,
// assistant = a B2B sales assistant on a website chat widget or Telegram). `config` is the sanitised settings; `secret` is
// AES-GCM sealed JSON (webhook signing secret, WordPress application password, Telegram bot token). `publicKey` is the only
// name the public feed, embed scripts, chat endpoint and hosted pages know the agent by.
model CustomAgent {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String    @default("visibility")
  name       String    @db.VarChar(120)
  // draft | active | paused
  status     String    @default("draft")
  publicKey  String    @unique
  config     Json
  secret     String?   @db.Text
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  posts      CustomAgentPost[]
  chats      CustomAgentChat[]

  @@index([userId, createdAt])
  @@index([status, nextRunAt])
}

// One article written by a visibility agent. `body` is already sanitised HTML (a small allow-list of tags).
model CustomAgentPost {
  id          String      @id @default(cuid())
  agentId     String
  agent       CustomAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  userId      String
  slug        String      @db.VarChar(160)
  title       String      @db.VarChar(200)
  summary     String      @db.VarChar(400)
  body        String      @db.MediumText
  keywords    Json?
  // draft | published | rejected
  status      String      @default("draft")
  // ai | rules | manual
  source      String      @default("ai")
  // Result of pushing to webhook / WordPress: [{ dest, ok, detail }]
  pushed      Json?
  publishedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([agentId, slug])
  @@index([agentId, status, publishedAt])
}

// One visitor conversation with an assistant agent, on the website widget or Telegram. `visitor` is what the assistant
// learned (name, email, company, phone, need); `messages` is the recent transcript (capped).
model CustomAgentChat {
  id         String      @id @default(cuid())
  agentId    String
  agent      CustomAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  userId     String
  channel    String      @db.VarChar(20)
  externalId String      @db.VarChar(120)
  visitor    Json?
  messages   Json
  // open | lead | closed
  status     String      @default("open")
  notifiedAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([agentId, channel, externalId])
  @@index([agentId, status, updatedAt])
}

// Something an assistant can answer from: a website, a PDF, a CSV table or Q&A list. The text is split into KnowledgeChunk rows
// (the original file is not kept). An assistant uses the sources listed in its config.knowledgeIds.
model KnowledgeSource {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // website | pdf | table | qa | text
  kind      String   @db.VarChar(16)
  name      String   @db.VarChar(160)
  // ready | error
  status    String   @default("ready")
  error     String?  @db.VarChar(300)
  // website: { url, pages }  pdf: { filename, pages }  table/qa: { filename, rows }
  meta      Json?
  chars     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chunks    KnowledgeChunk[]

  @@index([userId, createdAt])
}

model KnowledgeChunk {
  id       String          @id @default(cuid())
  sourceId String
  source   KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  userId   String
  idx      Int
  // Where it came from (a page URL, "page 3", a row number): shown in previews, never invented.
  label    String?         @db.VarChar(200)
  text     String          @db.Text

  @@index([sourceId, idx])
  @@index([userId])
}

// Admin-controlled site settings (feature switches, banner, maintenance, default limits). One JSON row per key
// (currently just "site"). Missing row or missing table = the built-in defaults, so the app never depends on it.
model SiteSetting {
  key       String   @id @db.VarChar(64)
  value     String   @db.Text
  updatedBy String?  @db.VarChar(191)
  updatedAt DateTime @updatedAt
}

// Admin-built email campaigns for RUNVAX's own users (announcements, trial nudges, win-backs). The settings
// (goal, audience filters, the emails) live in `config`; who got which email is recorded in LifecycleEmail
// under the key "pc:<id>:<step>", the same table the launch emails use, so a send can never double-send.
model PlatformCampaign {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(120)
  purpose   String   @db.VarChar(32)
  status    String   @default("draft") @db.VarChar(16) // draft | active | paused | finished
  config    Json
  createdBy String   @db.VarChar(191)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
}

// Help & support tickets. A customer opens a ticket from Help & support; admins reply in the admin "Support" tab.
// `ref` is the short reference shown to people (RX-ABC123). Staff replies are emailed to the customer.
model SupportTicket {
  id          String           @id @default(cuid())
  ref         String           @unique @db.VarChar(16)
  userId      String           @db.VarChar(191)
  email       String           @db.VarChar(191)
  name        String?          @db.VarChar(191)
  subject     String           @db.VarChar(160)
  category    String           @default("question") @db.VarChar(24)
  status      String           @default("open") @db.VarChar(16) // open | pending (waiting on customer) | resolved | closed
  lastBy      String           @default("user") @db.VarChar(8) // user | staff
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  lastReplyAt DateTime         @default(now())
  messages    SupportMessage[]

  @@index([userId, updatedAt])
  @@index([status, lastReplyAt])
}

model SupportMessage {
  id         String        @id @default(cuid())
  ticketId   String        @db.VarChar(191)
  author     String        @db.VarChar(8) // user | staff
  authorName String?       @db.VarChar(191)
  body       String        @db.Text
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}


// ── Career Agent (Phase 1). Its own data boundary: every row belongs to one user and is read only through that user's id. ──
// The profile is the VERIFIED source of truth: `profile` holds what was read from the CV, `confirmedAt` is set only when the
// candidate has reviewed it. Nothing the agent writes may go beyond it.
model CareerProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile     Json
  // ai | rules | manual
  source      String    @default("rules") @db.VarChar(12)
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// An uploaded CV. Only the extracted text is kept (the original file is not stored). `kind` = uploaded | generated.
model CareerDocument {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   @default("uploaded") @db.VarChar(12)
  name      String   @db.VarChar(200)
  mime      String?  @db.VarChar(80)
  text      String   @db.MediumText
  chars     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Job preferences + discovery settings + application permissions + deploy state, one row per user.
model CareerPreference {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferences Json
  discovery   Json
  permissions Json
  // draft | active | paused
  status      String    @default("draft") @db.VarChar(10)
  deployedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Auditable log of what the Career Agent (and the candidate) did.
model CareerAgentEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent     String   @db.VarChar(24)
  action    String   @db.VarChar(40)
  detail    String?  @db.VarChar(400)
  ok        Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ── Career Agent Phase 2: discovered vacancies and how well they fit. Per user; `dedupeKey` stops the same job (found on two sources) appearing twice. ──
model JobListing {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // remotive | arbeitnow | greenhouse | lever
  source      String    @db.VarChar(16)
  externalId  String    @db.VarChar(120)
  dedupeKey   String    @db.VarChar(64)
  title       String    @db.VarChar(200)
  company     String    @db.VarChar(160)
  location    String    @default("") @db.VarChar(200)
  remote      Boolean   @default(false)
  url         String    @db.VarChar(600)
  description String    @db.Text
  postedAt    DateTime?
  createdAt   DateTime  @default(now())
  match       JobMatch?

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
}

model JobMatch {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String     @unique
  listing   JobListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  score     Int
  reasons   Json
  // new | saved | dismissed
  status    String     @default("new") @db.VarChar(10)
  createdAt DateTime   @default(now())
  application JobApplication?

  @@index([userId, status, score])
}

// ── Career Agent Phase 3: an application the agent PREPARED for one matched job. Nothing here means "sent": `appliedAt` is set only when
// the candidate says they applied (appliedBy 'user'); an agent submission (Phase 4) would set appliedBy 'agent'. `cv` is a tailored copy built only
// from the confirmed profile; `approvedAt` is the candidate's approval record.
model JobApplication {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchId     String    @unique
  match       JobMatch  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  // prepared | approved | rejected | applied
  status      String    @default("prepared") @db.VarChar(10)
  cv          Json
  coverLetter String    @db.Text
  answers     Json
  gaps        Json
  flags       Json
  // ai | rules
  source      String    @default("rules") @db.VarChar(8)
  edited      Boolean   @default(false)
  approvedAt  DateTime?
  appliedAt   DateTime?
  appliedBy   String?   @db.VarChar(8)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  interviews  CareerInterview[]
  responses   CareerResponse[]
  submissions ApplicationSubmission[]

  @@index([userId, status, updatedAt])
}

// ── Career Agent Phase 5: what happened after applying. ──
// An employer reply the candidate pasted and confirmed. Only a short summary is kept, never the email body.
// kind: acknowledged | interview | info_request | rejected | offer | other, plus 'followed_up' = a follow-up the candidate sent (not an employer reply).
model CareerResponse {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String
  application   JobApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          String          @db.VarChar(14)
  subject       String          @default("") @db.VarChar(200)
  summary       String          @default("") @db.VarChar(600)
  receivedAt    DateTime
  createdAt     DateTime        @default(now())

  @@index([userId, receivedAt])
  @@index([applicationId])
}

model CareerInterview {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId  String?
  application    JobApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  company        String          @db.VarChar(160)
  title          String          @db.VarChar(200)
  // phone | video | onsite | other
  kind           String          @default("video") @db.VarChar(8)
  startsAt       DateTime
  location       String          @default("") @db.VarChar(300)
  notes          String          @db.Text
  // scheduled | done | cancelled
  status         String          @default("scheduled") @db.VarChar(10)
  prep           Json?
  reminderSentAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId, startsAt])
}

// ── Career Agent Phase 4: one attempt to submit a prepared + approved application on the employer's own hosted form (Greenhouse or Lever).
// `status`: queued | running | submitted | needs_you | unconfirmed | failed | cancelled | checked.
// 'submitted' is set ONLY after the site's own confirmation page was seen. 'unconfirmed' = the button was pressed but no confirmation appeared: it is never retried automatically (it could have gone through).
// 'checked' = a dry run (trigger 'check'): the form was read and mapped, nothing was typed or sent. `trigger`: user | rules | check.
model ApplicationSubmission {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  platform      String         @db.VarChar(12)
  status        String         @default("queued") @db.VarChar(12)
  trigger       String         @default("user") @db.VarChar(8)
  reason        String         @default("") @db.VarChar(600)
  questions     Json?
  steps         Json?
  evidence      String         @default("") @db.VarChar(600)
  finalUrl      String         @default("") @db.VarChar(600)
  attempts      Int            @default(0)
  createdAt     DateTime       @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([applicationId])
}
