# MySQL database — required for auth + prospect storage
# Format: mysql://USER:PASSWORD@HOST:3306/DBNAME
DATABASE_URL=

# NextAuth — required for session security (generate: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Public production domain — drives canonical URLs, sitemap.xml, robots.txt, and OG tags.
# Set this to the real domain once live (e.g. https://runvax.com); falls back to localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Places API (New) — required for business search
GOOGLE_PLACES_API_KEY=

# Google Maps JavaScript API — powers the inline map preview in the search form.
# Browser-exposed (NEXT_PUBLIC_) — restrict it by HTTP referrer to your domain(s)
# in Google Cloud Console, and enable both "Maps JavaScript API" and "Geocoding API".
# This must be a separate key from GOOGLE_PLACES_API_KEY above, which stays server-only.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# OpenAI — required for AI outreach, proposals, briefs
OPENAI_API_KEY=

# Gemini — free tier, 1,500 req/day — https://aistudio.google.com/
GEMINI_API_KEY=

# Groq — free tier, ultra-fast Llama 3.3 — https://console.groq.com/
GROQ_API_KEY=

# AI provider routing (optional — defaults to openai)
# Options: openai | gemini | groq
AI_PROVIDER_DEFAULT=openai
AI_PROVIDER_BRIEF=gemini
AI_PROVIDER_OUTREACH=openai

# Google Custom Search — OPTIONAL email discovery (currently dormant / not needed)
GOOGLE_CSE_ID=
GOOGLE_CSE_KEY=

# Brave Search — OPTIONAL whole-web email discovery. Also powers decision-maker search
# (public results, including LinkedIn profile titles); without it a best-effort Bing fallback is used.
BRAVE_SEARCH_KEY=

# Decision-maker lookup — OPTIONAL paid sources, used only on "Search deeper" (paid plans, 20/day/user).
# Each is skipped when its key is blank. Run order: Hunter, Apollo, Apify; stops at the first strong hit.
HUNTER_API_KEY=
APOLLO_API_KEY=
APIFY_TOKEN=
# Snov.io — OPTIONAL email finder, used on "Search deeper" after Hunter when a person's name is known.
# Both are required (app.snov.io/account/api). 60 requests/minute; Email Finder costs 1 credit per address found.
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=
# Apify actor that returns people for a company ("username~actor-name") and its JSON input.
# {{business}}, {{domain}}, {{city}} are filled in. Vet the actor's data source yourself.
APIFY_DM_ACTOR=
APIFY_DM_INPUT={"companyName":"{{business}}","companyDomain":"{{domain}}","maxItems":5}

# Resend — free SMTP relay, 3,000 emails/month — https://resend.com/
# When set, takes priority over SMTP_HOST/PORT/USER/PASS below
RESEND_API_KEY=

# SMTP — fallback email delivery (used when RESEND_API_KEY is not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-email@gmail.com

# Paystack — https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Create plans in Paystack dashboard → Products → Subscriptions → Plans
PAYSTACK_PRO_PLAN_CODE=
PAYSTACK_AGENCY_PLAN_CODE=

# Admin — comma-separated email addresses that get admin access
ADMIN_EMAILS=

# WhatsApp Business API — template name used when creating/sending the outreach template.
# Optional — defaults to 'runvax_outreach_v1'. Change only if you need a different template name in Meta.
WHATSAPP_TEMPLATE_NAME=

# Sentry — https://sentry.io (optional but strongly recommended for production)
# Create a Next.js project at sentry.io and paste the DSN here
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Cron security — generate: openssl rand -hex 32
# Must match the Authorization header sent by Vercel Cron: Bearer <CRON_SECRET>
CRON_SECRET=

# Nova (SEO agent) needs this to open a PR when it autonomously drafts a blog
# post — a fine-grained PAT with Contents + Pull requests write access on the
# repo below (or a classic PAT with the "repo" scope). Without these two set,
# the /api/cron/generate-post cron drafts nothing and returns a clear error.
GITHUB_TOKEN=
GITHUB_REPO=agbona24/AI-Prospect-Tracker

# Google Analytics 4 — optional. Create a property at analytics.google.com,
# paste the "G-XXXXXXX" measurement ID below to activate tracking site-wide.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Industry Acquisition Engine — admin-only, OFF unless exactly "true".
# See docs/industry-acquisition.md. Do not enable in production without approval.
INDUSTRY_ACQUISITION_ENABLED=false
# Tasks per drain (default 10, max 50) and per-task timeout in ms (default 45000)
IA_TASK_BUDGET=
IA_TASK_TIMEOUT_MS=
# Model for acquisition agents (default gpt-4o-mini); per agent: IA_MODEL_AUDIT, IA_MODEL_OUTREACH, …
IA_MODEL_DEFAULT=
# Phase 2 research limits (platform-wide, Africa/Lagos day). Caps are ceilings, not targets.
IA_PLACES_DAILY_CAP=50
IA_WEB_PAGES_DAILY_CAP=500
IA_PSI_DAILY_CAP=100
IA_DNS_DAILY_CAP=500
IA_DAILY_TASK_CAP=200
# Google Places stays disabled in Phase 2 (also needs ACTIVATION.googlePlaces in code + legal review).
IA_PLACES_ENABLED=false
# Website research crawler: off unless enabled AND given a genuine public https policy/contact URL.
# The live transport additionally requires ACTIVATION.liveWebFetch in code (false in Phase 2).
IA_CRAWLER_ENABLED=false
IA_CRAWLER_POLICY_URL=
# Suppression / erasure tombstones are keyed hashes. REQUIRED for the acquisition module
# (it fails closed without one). Generate: openssl rand -base64 48 — keep in the secret store,
# never commit. See docs/suppression-keys.md for rotation, recovery and migration.
IA_SUPPRESSION_KEY=
IA_SUPPRESSION_KEY_ID=k1
IA_SUPPRESSION_KEYS_PREVIOUS=
IA_SUPPRESSION_LEGACY_MATCH=false
